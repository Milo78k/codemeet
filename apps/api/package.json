{
  "name": "@codemeet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schema.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand"
  },
  "dependencies": {
    "@codemeet/db": "workspace:*",
    "@codemeet/shared": "workspace:*",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.1",
    "lib0": "0.2.119",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemeet/config": "workspace:*",
    "@jest/globals": "30.5.2",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
