{
  "name": "codemeet",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.15.0 <23",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint eslint.config.mjs --max-warnings=0",
    "lint:fix": "turbo run lint:fix && eslint eslint.config.mjs --fix --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "graphql:codegen": "pnpm --filter @codemeet/web graphql:codegen",
    "graphql:codegen:watch": "pnpm --filter @codemeet/web graphql:codegen:watch",
    "graphql:codegen:check": "pnpm --filter @codemeet/web graphql:codegen:check",
    "db:generate": "pnpm --filter @codemeet/db db:generate",
    "db:validate": "pnpm --filter @codemeet/db db:validate",
    "db:migrate": "pnpm --filter @codemeet/db db:migrate",
    "db:migrate:dev": "pnpm --filter @codemeet/db db:migrate:dev",
    "db:seed": "pnpm --filter @codemeet/db db:seed",
    "db:studio": "pnpm --filter @codemeet/db db:studio",
    "db:reset": "pnpm --filter @codemeet/db db:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm graphql:codegen:check && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@codemeet/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  }
}
