{
  "name": "@codemeet/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "pnpm build && tsc --noEmit",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "db:validate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js validate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:seed": "pnpm build && node --env-file-if-exists=../../.env node_modules/prisma/build/index.js db seed",
    "db:studio": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js studio",
    "db:reset": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@codemeet/config": "workspace:*",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
