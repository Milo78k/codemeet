# Скопируйте в .env в корне monorepo. Значения ниже только для local development.
# Замените password здесь и в обоих URL. Специальные символы в URL кодируйте.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://codemeet:change-me-local-only@127.0.0.1:5432/codemeet?schema=public
TEST_DATABASE_URL=postgresql://codemeet:change-me-local-only@127.0.0.1:5432/codemeet_test?schema=public

API_HOST=127.0.0.1
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public browser endpoint. Next.js embeds this value at build time.
NEXT_PUBLIC_GRAPHQL_URL=http://127.0.0.1:4000/graphql
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:4000/collaboration

# TEMP DEMO AUTH: все business operations выполняются от demo@codemeet.local.
# Только локальная разработка; API отвергает этот режим при NODE_ENV=production.
DEMO_AUTH_ENABLED=true

# Auth.js и реальные auth credentials пока не реализованы.
# Не храните реальные секреты в .env.example или Git; .env исключён из Git.
